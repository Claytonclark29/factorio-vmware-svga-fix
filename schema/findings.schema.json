{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SVGA findings v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "title",
          "expected",
          "observed",
          "conditions",
          "evidence",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[A-Z]+(?:-HYP)?-[0-9]{3}$"
          },
          "status": {
            "enum": [
              "verified-fix-in-tested-scope",
              "unresolved",
              "observed-unresolved",
              "untested-hypothesis",
              "observed-improvement"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
